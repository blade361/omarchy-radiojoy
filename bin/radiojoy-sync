#!/bin/bash
# Makes the desktop follow the wallpaper while the Radiojoy theme is active:
# Alastor wallpapers (NN-alastor.*), Emily wallpapers (NN-emily.*) and Radiojoy
# ones (anything else) each get their own screensaver art, window border and
# Spotify colours, and unused terminals redraw their splash. On other themes it
# puts everything back. Run by radiojoy-sync.path and the theme-set hook.
s="$HOME/.local/state/omarchy"
t="$s/current/theme"
branding="$HOME/.config/omarchy/branding"

case $(readlink -f "$s/current/background") in
  *-alastor.*) who=alastor ;;
  *-emily.*) who=emily ;;
  *) who= ;;
esac
active=; [[ -f $t/radiojoy ]] && active=1

# During Radiojoy Week the wallpaper is the week's collage and can't be changed:
# any other wallpaper is switched straight back (that switch runs this again).
if [[ $active ]] && grep -qs "^$(date +%F)"$'\t' "$t/radiojoy-week.txt"; then
  collage=$HOME/.config/omarchy/backgrounds/radiojoy/radiojoy-week-$(date +%Y).png
  if [[ -f $collage && $(readlink -f "$s/current/background") != "$(readlink -f "$collage")" ]]; then
    omarchy-theme-bg-set "$collage" >/dev/null 2>&1
    exit 0
  fi
fi

# Screensaver: the user's own art is kept in screensaver.user.txt meanwhile.
if [[ $active ]]; then
  src=$t/screensaver${who:+-$who}.txt
  [[ -f $src ]] || src=$t/screensaver.txt
  mkdir -p "$branding"
  [[ -f $branding/.radiojoy ]] || { [[ -f $branding/screensaver.txt ]] && cp "$branding/screensaver.txt" "$branding/screensaver.user.txt"; }
  cmp -s "$src" "$branding/screensaver.txt" || cp "$src" "$branding/screensaver.txt"
  touch "$branding/.radiojoy"
elif [[ -f $branding/.radiojoy ]]; then
  if [[ -f $branding/screensaver.user.txt ]]; then
    mv "$branding/screensaver.user.txt" "$branding/screensaver.txt"
  else
    rm -f "$branding/screensaver.txt"
  fi
  rm -f "$branding/.radiojoy"
fi

# Bar, menus, notifications and popups: the shell recolours live from a colours
# payload (what omarchy theme set sends it), here the character's palette.
if [[ $active && -f $t/shell/colors-${who:-radiojoy}.toml ]] && command -v omarchy-shell >/dev/null; then
  timeout 2 omarchy-shell shell applyTheme \
    "$(base64 -w0 "$t/shell/colors-${who:-radiojoy}.toml")" \
    "$(base64 -w0 "$t/shell/shell-${who:-radiojoy}.toml")" >/dev/null 2>&1
fi

# Window border: the theme's hyprland.lua reads radiojoy-border on every reload;
# apply it live too.
if [[ $active ]]; then
  colors=$(sed -n "s/^${who:-radiojoy}=//p" "$t/borders")
  if [[ -n $colors && $(cat "$s/radiojoy-border" 2>/dev/null) != "$colors" ]]; then
    printf '%s\n' "$colors" >"$s/radiojoy-border"
    list=$(printf '"%s", ' $colors)
    g="{ colors = { ${list%, } }, angle = 45 }"
    hyprctl eval "hl.config({ general = { col = { active_border = $g } }, group = { col = { border_active = $g } } })" >/dev/null 2>&1
  fi
else
  rm -f "$s/radiojoy-border"
fi

# Spotify (with Spicetify): the radiojoy-follow extension polls my-colors.json.
if command -v spicetify >/dev/null; then
  xpui="$(spicetify config spotify_path 2>/dev/null)Apps/xpui"
  if [[ -d $xpui && -w $xpui ]]; then
    pairs=
    if [[ $active && -n $who && -f $t/spotify ]]; then
      pairs=$(awk -v sec="[$who]" '/^\[/{on = ($0 == sec); next} on && /=/{split($0, kv, "="); printf "%s\"%s\":\"%s\"", (n++ ? "," : ""), kv[1], kv[2]}' "$t/spotify")
    fi
    printf '{"who":"%s","colors":{%s}}\n' "$who" "$pairs" >"$xpui/radiojoy-colors.json.tmp" &&
      mv "$xpui/radiojoy-colors.json.tmp" "$xpui/radiojoy-colors.json"
  fi
fi

# Zen / Firefox: profiles whose userChrome.css imports radiojoy-zen.css get the
# wallpaper's colours (read when the browser starts). Opt-in, see the README.
for css in "$HOME"/.config/zen/*/chrome/userChrome.css "$HOME"/.zen/*/chrome/userChrome.css "$HOME"/.mozilla/firefox/*/chrome/userChrome.css; do
  grep -qs 'radiojoy-zen.css' "$css" || continue
  out=${css%/*}/radiojoy-zen.css
  ini=$t/shell/colors-${who:-radiojoy}.toml
  if [[ $active && -f $ini ]]; then
    c() { sed -nE "s/^$1[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\".*/\1/p" "$ini"; }
    cat >"$out" <<CSS
/* written by radiojoy-sync for the current wallpaper */
:root {
  --zen-primary-color: $(c accent) !important;
  --zen-colors-primary: $(c lighter_background) !important;
  --zen-colors-secondary: $(c selection) !important;
  --zen-colors-tertiary: $(c dark_background) !important;
  --zen-colors-border: $(c accent) !important;
  --zen-main-browser-background: $(c background) !important;
  --zen-main-browser-background-toolbar: $(c background) !important;
  --toolbar-bgcolor: $(c background) !important;
  --toolbar-color: $(c foreground) !important;
  --toolbox-textcolor: $(c foreground) !important;
  --tab-selected-bgcolor: $(c lighter_background) !important;
}
CSS
  else
    : >"$out"
  fi
done

# Terminal colours: idle terminals switch palette now, new ones in the .bashrc block.
if [[ $active ]]; then
  "$(dirname "$(readlink -f "$0")")/radiojoy-term-colors" --idle
  touch "$s/radiojoy-term-colors"
elif [[ -f $s/radiojoy-term-colors ]]; then
  "$(dirname "$(readlink -f "$0")")/radiojoy-term-colors" --idle   # resets them
  rm -f "$s/radiojoy-term-colors"
fi

# Terminals still at their first prompt redraw their splash.
[[ $active ]] && "$(dirname "$(readlink -f "$0")")/radiojoy-splash-refresh"
exit 0
