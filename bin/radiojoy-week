#!/usr/bin/env python3
# Radiojoy Week wallpaper: during the week listed in the theme's radiojoy-week.txt,
# builds a collage of only that week's art (fetched from the artists in
# radiojoy-week-artists.txt as they post it) with the prompt list beside it, past
# days crossed out. Whenever the collage changes (a new day or new art) it becomes
# the wallpaper. When the week is over it becomes a keepsake collage of all the
# week's art that stays in the wallpaper carousel (late posts are still added for
# a few days). Run hourly by radiojoy-week.timer.
#   --discover  look for an upcoming Radiojoy Week (radiojoy-week-discover.timer):
#               reads announcement banners with OCR, adds the dates and prompts to
#               radiojoy-week.txt and sends a notification to check them.
import datetime as dt, hashlib, html, json, os, re, subprocess, sys, urllib.parse, urllib.request
from pathlib import Path

HOME = Path.home()
THEME = HOME / ".local/state/omarchy/current/theme"
OUT_DIR = HOME / ".config/omarchy/backgrounds/radiojoy"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "radiojoy-week"
BG_LINK = HOME / ".local/state/omarchy/current/background"
UA = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) omarchy-radiojoy"}
FONTS = Path("/usr/share/fonts/noto")


def log(*a):
    print(*a, file=sys.stderr)


def week_days(today):
    """[(date, prompt)] for the week containing today, or []."""
    for w in all_weeks():
        if w[0][0] <= today <= w[-1][0]:
            return w
    return []


def all_weeks():
    """Every week in radiojoy-week.txt, oldest first, as [(date, prompt)] lists."""
    f = THEME / "radiojoy-week.txt"
    rows = []
    for line in f.read_text().splitlines() if f.exists() else []:
        m = re.match(r"(\d{4}-\d{2}-\d{2})\t(.+)", line)
        if m:
            rows.append((dt.date.fromisoformat(m[1]), m[2].strip()))
    rows.sort()
    # consecutive runs of dates are one week
    weeks, cur = [], []
    for d, p in rows:
        if cur and (d - cur[-1][0]).days != 1:
            weeks.append(cur)
            cur = []
        cur.append((d, p))
    if cur:
        weeks.append(cur)
    return weeks


# Feeds and images come from posts, which could otherwise point at file:// paths
# or machines on the local network: only https to these hosts, checked for every
# redirect before it is followed.
FEED_HOSTS = ("public.api.bsky.app", "tumblr.com", "backend.deviantart.com")
IMAGE_HOSTS = ("cdn.bsky.app", "media.tumblr.com", "wixmp.com")  # Bluesky, Tumblr, DeviantArt CDNs
MAX_BYTES = 25 * 1024 * 1024


def allowed(url, hosts):
    u = urllib.parse.urlsplit(url)
    host = (u.hostname or "").lower()
    return u.scheme == "https" and any(host == h or host.endswith("." + h) for h in hosts)


def get(url, binary=False):
    hosts = IMAGE_HOSTS if binary else FEED_HOSTS
    if not allowed(url, hosts):
        raise ValueError(f"refusing {url!r}")

    class Redirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not allowed(newurl, hosts):
                raise ValueError(f"refusing redirect to {newurl!r}")
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    opener = urllib.request.build_opener(Redirects)
    with opener.open(urllib.request.Request(url, headers=UA), timeout=20) as r:
        data = r.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError(f"too large: {url!r}")
    return data if binary else data.decode("utf-8", "replace")


def event_date(utc):
    """A post's date in US time (UTC-6), where these events are run; a post made the
    evening of Day 1 there is already Day 2 in Europe."""
    return (utc - dt.timedelta(hours=6)).date()


def day_of(text, posted, week):
    m = re.search(r"\bday\s*([1-9])\b", text, re.I)
    if m and int(m[1]) <= len(week):
        return int(m[1])
    for i, (d, _) in enumerate(week, 1):
        if d == posted:
            return i
    return None


def fetch_bluesky(handle, week):
    feed = json.loads(get("https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed"
                          f"?actor={handle}&limit=60&filter=posts_with_media"))
    for item in feed.get("feed", []):
        if item.get("reason"):  # a repost
            continue
        p = item["post"]
        if p["author"]["handle"] != handle:
            continue
        text = p["record"].get("text", "")
        if "radiojoyweek" not in re.sub(r"[\s#_]", "", text.lower()):
            continue
        posted = event_date(dt.datetime.fromisoformat(p["record"]["createdAt"].replace("Z", "+00:00")))
        if posted < week[0][0] - dt.timedelta(days=1):
            continue
        emb = p.get("embed", {})
        images = emb.get("images") or (emb.get("media") or {}).get("images") or []
        for k, im in enumerate(images):
            yield {"id": f"{p['uri'].rsplit('/', 1)[-1]}-{k}", "url": im["fullsize"],
                   "day": day_of(text, posted, week),
                   "link": f"https://bsky.app/profile/{handle}/post/{p['uri'].rsplit('/', 1)[-1]}"}


def fetch_tumblr(blog, week):
    raw = get(f"https://{blog}.tumblr.com/api/read/json?num=40")
    data = json.loads(raw[raw.index("{"):raw.rindex("}") + 1])
    for p in data.get("posts", []):
        body = p.get("regular-body", "") + p.get("photo-caption", "")
        if "tumblr_blog" in body:  # a reblog
            continue
        tags = " ".join(t.lower() for t in p.get("tags", []))
        if "radiojoy week" not in tags and "radiojoyweek" not in tags:
            continue
        posted = event_date(dt.datetime.fromtimestamp(int(p["unix-timestamp"]), dt.timezone.utc))
        if posted < week[0][0] - dt.timedelta(days=1):
            continue
        text = html.unescape(re.sub(r"<[^>]+>", " ", body))
        urls = []
        for tag in re.findall(r"<img[^>]+>", body):
            srcset = re.search(r'srcset="([^"]+)"', tag)
            if srcset:
                best = max((c.strip().rsplit(" ", 1) for c in html.unescape(srcset[1]).split(",")),
                           key=lambda c: int(c[1].rstrip("w")))[0]
            else:
                best = re.search(r'src="([^"]+)"', tag)[1]
            urls.append(best)
        for ph in p.get("photos", []):
            urls.append(ph["photo-url-1280"])
        for k, u in enumerate(urls):
            yield {"id": f"{p['id']}-{k}", "url": u, "day": day_of(text, posted, week),
                   "link": p.get("url-with-slug") or p.get("url")}


def collect(week):
    """Download new week art into the cache; return the list of pieces."""
    year_dir = CACHE / str(week[0][0].year)
    year_dir.mkdir(parents=True, exist_ok=True)
    index_file = year_dir / "index.json"
    index = json.loads(index_file.read_text()) if index_file.exists() else {}
    artists = THEME / "radiojoy-week-artists.txt"
    for line in artists.read_text().splitlines() if artists.exists() else []:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        kind, account, name = (line.split(None, 2) + [""])[:3]
        try:
            found = list((fetch_bluesky if kind == "bluesky" else fetch_tumblr)(account, week))
        except Exception as e:  # offline or the site changed: keep what we have
            log(f"{account}: {e!r}")
            continue
        for art in found:
            key = f"{kind}-{account}-{art['id']}"
            if key in index or art["day"] is None:
                continue
            try:
                data = get(art["url"], binary=True)
            except Exception as e:
                log(f"{key}: {e!r}")
                continue
            if not data.startswith((b"\xff\xd8", b"\x89PNG", b"GIF8", b"RIFF")):  # jpeg/png/gif/webp
                log(f"{key}: not an image")
                continue
            path = year_dir / (hashlib.sha1(key.encode()).hexdigest()[:12] + ".img")
            path.write_bytes(data)
            index[key] = {"file": path.name, "artist": name or account, "day": art["day"], "link": art["link"]}
    index_file.write_text(json.dumps(index, indent=1))
    pieces = [dict(v, key=k, path=str(year_dir / v["file"])) for k, v in index.items()]
    return drop_shared(pieces)


def drop_shared(pieces):
    """An image an artist attaches to several posts (an event banner) isn't art."""
    from PIL import Image
    def ahash(p):
        try:
            im = Image.open(p["path"]).convert("L").resize((8, 8))
        except Exception:
            return None
        px = list(im.tobytes())
        avg = sum(px) / len(px)
        return (p["artist"], tuple(v > avg for v in px))
    hashes = {}
    for p in pieces:
        p["hash"] = ahash(p)
        hashes.setdefault(p["hash"], set()).add(p["key"].rsplit("-", 1)[0])
    return [p for p in pieces if p["hash"] is not None and len(hashes[p["hash"]]) == 1]


def build(week, today, pieces, out, final=False):
    from PIL import Image, ImageDraw, ImageFilter, ImageFont
    W, H = 1920, 1080
    font = lambda name, size: ImageFont.truetype(str(FONTS / name), size)
    title_f, day_f, prompt_f = font("NotoSerifDisplay-BoldItalic.ttf", 64), font("NotoSerif-Bold.ttf", 24), font("NotoSerif-Regular.ttf", 22)
    small_f = font("NotoSerif-Italic.ttf", 17)
    icon = lambda size: ImageFont.truetype("/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf", size)
    STAR, CHECK, PLAY = "\uf005", "\uf00c", "\uf04b"  # Nerd Font icons; the serifs lack them

    # crimson → periwinkle, like the theme's pair wallpaper
    bg = Image.new("RGB", (W, H))
    stops = [(0, (26, 6, 10)), (0.45, (66, 12, 26)), (0.7, (52, 38, 86)), (1, (24, 26, 58))]
    grad = Image.new("RGB", (W, 1))
    for x in range(W):
        t = x / (W - 1)
        for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
            if t <= t1:
                f = (t - t0) / (t1 - t0)
                grad.putpixel((x, 0), tuple(int(c0[i] + (c1[i] - c0[i]) * f) for i in range(3)))
                break
    bg = grad.resize((W, H))
    bg = bg.convert("RGBA")
    d = ImageDraw.Draw(bg)

    top = 70  # below the bar
    d.text((60, top + 14), STAR, font=icon(52), fill=(242, 193, 78))
    d.text((128, top), f"Radiojoy Week {week[0][0].year}", font=title_f, fill=(242, 193, 78))

    # prompt list: done days crossed out, today highlighted
    y = top + 120
    for i, (day, prompt) in enumerate(week, 1):
        label, rest = (prompt.split(":", 1) + [""])[:2]
        if final:
            col, mark = (236, 233, 247), CHECK
        elif day < today:
            col, mark = (157, 153, 188), CHECK
        elif day == today:
            col, mark = (242, 193, 78), PLAY
            hl = Image.new("RGBA", bg.size, (0, 0, 0, 0))
            ImageDraw.Draw(hl).rounded_rectangle((44, y - 10, 540, y + 72), 12, fill=(242, 193, 78, 45))
            bg.alpha_composite(hl)
            d = ImageDraw.Draw(bg)
        else:
            col, mark = (236, 233, 247), ""
        d.text((60, y + 4), mark, font=icon(22), fill=col)
        d.text((92, y), label.strip(), font=day_f, fill=col)
        d.text((92, y + 32), rest.strip(), font=prompt_f, fill=col)
        if day < today and not final:  # done: crossed out
            for yy, text, f in ((y + 17, label.strip(), day_f), (y + 47, rest.strip(), prompt_f)):
                d.line((88, yy, 92 + d.textlength(text, font=f) + 4, yy), fill=(220, 34, 73), width=3)
        y += 108
    d.text((60, H - 70), f"{len(pieces)} piece{'s' if len(pieces) != 1 else ''}"
           + (" · thank you, artists!" if final else " so far · art by the artists, credited on each"),
           font=small_f, fill=(200, 196, 220))

    # the art, newest day last, in the biggest grid that fits
    ax0, ay0, ax1, ay1 = 580, top + 110, W - 40, H - 40
    pieces = sorted(pieces, key=lambda p: (p["day"], p["artist"], p["key"]))
    if not pieces:
        d.text(((ax0 + ax1) // 2, (ay0 + ay1) // 2), "The art arrives here as the artists post it",
               font=prompt_f, fill=(236, 233, 247), anchor="mm")
    else:
        n, aw, ah = len(pieces), ax1 - ax0, ay1 - ay0
        best = None
        for cols in range(1, n + 1):
            rows = -(-n // cols)
            cw, ch = aw / cols, ah / rows
            if best is None or min(cw, ch * 0.8) > best[2]:
                best = (cols, rows, min(cw, ch * 0.8))
        cols, rows, _ = best
        cw, ch = aw / cols, ah / rows
        for i, p in enumerate(pieces):
            cx, cy = ax0 + (i % cols) * cw, ay0 + (i // cols) * ch
            try:
                im = Image.open(p["path"]).convert("RGB")
            except Exception:
                continue
            bw, bh = cw - 24, ch - 44
            s = min(bw / im.width, bh / im.height)
            im = im.resize((max(1, int(im.width * s)), max(1, int(im.height * s))), Image.LANCZOS)
            x, yy = int(cx + (cw - im.width) / 2), int(cy + 8 + (bh - im.height) / 2)
            glow = Image.new("RGBA", bg.size, (0, 0, 0, 0))
            ImageDraw.Draw(glow).rectangle((x - 6, yy - 6, x + im.width + 6, yy + im.height + 6), fill=(242, 193, 78, 90))
            bg.alpha_composite(glow.filter(ImageFilter.GaussianBlur(10)))
            d = ImageDraw.Draw(bg)
            d.rectangle((x - 3, yy - 3, x + im.width + 2, yy + im.height + 2), outline=(236, 233, 247), width=2)
            bg.paste(im, (x, yy))
            d.text((x + im.width / 2, yy + im.height + 18), f"Day {p['day']} · {p['artist']}",
                   font=small_f, fill=(236, 233, 247), anchor="mm")
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(".tmp.png")
    bg.convert("RGB").save(tmp)
    tmp.replace(out)


def set_wallpaper(path):
    subprocess.run(["omarchy-theme-bg-set", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


GRACE_DAYS = 3  # late posts still join the keepsake collage this long after the week


def notify(title, body):
    subprocess.run(["notify-send", "-a", "Radiojoy", title, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_state():
    f = CACHE / "state.json"
    return json.loads(f.read_text()) if f.exists() else {}


def save_state(state):
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "state.json").write_text(json.dumps(state, indent=1))


def main():
    if not (THEME / "radiojoy").exists():
        return
    if "--discover" in sys.argv:
        return discover()
    today = dt.date.today()
    state = load_state()
    force = "--force" in sys.argv

    # finished weeks: keep a collage of all their art in the carousel
    for w in all_weeks():
        end, year = w[-1][0], str(w[0][0].year)
        if not end < today <= end + dt.timedelta(days=GRACE_DAYS) and not (force and end < today):
            continue
        out = OUT_DIR / f"radiojoy-week-{year}.png"
        pieces = collect(w)
        sig = hashlib.sha1(json.dumps(["final"] + sorted(p["key"] for p in pieces)).encode()).hexdigest()
        if state.get(f"final-{year}") != sig or not out.exists() or force:
            build(w, today, pieces, out, final=True)
            state[f"final-{year}"] = sig
            save_state(state)

    week = week_days(today)
    if not week:
        return
    out = OUT_DIR / f"radiojoy-week-{week[0][0].year}.png"
    pieces = collect(week)
    sig = hashlib.sha1(json.dumps([str(today)] + sorted(p["key"] for p in pieces)).encode()).hexdigest()
    if sig == state.get("sig") and out.exists() and not force:
        return
    build(week, today, pieces, out)
    state["sig"] = sig
    save_state(state)
    set_wallpaper(out)  # a new day or new art: show it


# --- discovering the next Radiojoy Week ------------------------------------

MONTHS = "january february march april may june july august september october november december".split()
NUMBERS = {w: i for i, w in enumerate("one two three four five six seven".split(), 1)}


def parse_announcement(text):
    """Dates and prompts from an announcement (post text or OCR of its banner).
    Returns (first_date, [prompt, ...]) or None; prompts may be [] if unreadable."""
    t = re.sub(r"[ \t]+", " ", text)
    month = r"(" + "|".join(m[:3] for m in MONTHS) + r")[a-z]*\.?"
    m = re.search(month + r" (\d{1,2})(?:st|nd|rd|th)? ?[-–—~to ]+ ?(?:" + month
                  + r" )?(\d{1,2})(?:st|nd|rd|th)?,? ?(20\d\d)", t, re.I)
    if not m:
        return None
    start = dt.date(int(m[5]), [x[:3] for x in MONTHS].index(m[1].lower()) + 1, int(m[2]))
    prompts, last = {}, None
    for line in t.splitlines():
        line = line.strip()
        dm = re.match(r"^\W*(?:\S{0,4}\s)?(one|two|three|four|five|six|seven|[1-7])\s*[:;.]\s*(.+)$", line, re.I)
        if dm and dm[2].strip():
            n = int(dm[1]) if dm[1].isdigit() else NUMBERS[dm[1].lower()]
            prompts[n] = dm[2].strip()
            last = n
        elif last and line and (prompts[last].endswith("/") or line[:1].islower() or line.lower().startswith("and ")):
            prompts[last] += " " + line  # a prompt wrapped onto the next line
    days = [prompts.get(i, f"Day {i}") for i in range(1, 8)] if len(prompts) >= 4 else []
    return start, [f"Day {i}: {p.split(':', 1)[-1].strip() if p.startswith('Day') else p}" for i, p in enumerate(days, 1)]


def ocr(data):
    import shutil, tempfile
    if not shutil.which("tesseract"):
        return ""
    from PIL import Image, ImageOps
    import io
    try:
        im = Image.open(io.BytesIO(data)).convert("L")
    except Exception:
        return ""
    im = ImageOps.autocontrast(im.resize((im.width * 2, im.height * 2)))
    with tempfile.NamedTemporaryFile(suffix=".png") as f:
        im.save(f.name)
        return subprocess.run(["tesseract", f.name, "-"], capture_output=True, text=True).stdout


def announcements():
    """(text, [image urls], link) for recent posts that mention a Radiojoy Week."""
    artists = THEME / "radiojoy-week-artists.txt"
    for line in artists.read_text().splitlines() if artists.exists() else []:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        kind, account = line.split()[:2]
        try:
            if kind == "bluesky":
                feed = json.loads(get("https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed"
                                      f"?actor={account}&limit=60"))
                for item in feed.get("feed", []):
                    p = item["post"]
                    emb = p.get("embed", {})
                    imgs = emb.get("images") or (emb.get("media") or {}).get("images") or []
                    yield (p["record"].get("text", ""), [i["fullsize"] for i in imgs],
                           f"https://bsky.app/profile/{p['author']['handle']}/post/{p['uri'].rsplit('/', 1)[-1]}")
            else:
                raw = get(f"https://{account}.tumblr.com/api/read/json?num=50")
                for p in json.loads(raw[raw.index("{"):raw.rindex("}") + 1]).get("posts", []):
                    body = p.get("regular-body", "") + p.get("photo-caption", "")
                    text = html.unescape(re.sub(r"<[^>]+>", " ", body)) + " " + " ".join(p.get("tags", []))
                    imgs = [re.search(r'src="([^"]+)"', t)[1] for t in re.findall(r"<img[^>]+>", body)]
                    imgs += [ph["photo-url-1280"] for ph in p.get("photos", [])]
                    yield text, imgs, p.get("url-with-slug") or p.get("url")
        except Exception as e:
            log(f"{account}: {e!r}")
    try:  # DeviantArt's public search feed reaches beyond the listed artists
        rss = get("https://backend.deviantart.com/rss.xml?type=deviation&q=radiojoy+week")
        for item in re.findall(r"<item>(.*?)</item>", rss, re.S):
            title = html.unescape(re.search(r"<title>(.*?)</title>", item, re.S)[1])
            desc = html.unescape((re.search(r"<description>(.*?)</description>", item, re.S) or [None, ""])[1])
            img = re.search(r'<media:content url="([^"]+)"', item)
            link = re.search(r"<link>(.*?)</link>", item)[1]
            yield title + "\n" + re.sub(r"<[^>]+>", " ", desc), [html.unescape(img[1])] if img else [], link
    except Exception as e:
        log(f"deviantart: {e!r}")


def discover():
    today = dt.date.today()
    known = {w[0][0].year for w in all_weeks()}
    state = load_state()
    seen = set(state.get("discover-seen", []))
    found = {}
    for text, imgs, link in announcements():
        if not re.search(r"radio\s*joy\s*week", text, re.I):
            continue
        hit = parse_announcement(text)
        if not (hit and hit[1]):
            for url in imgs[:2]:  # the dates and prompts are usually on the banner
                try:
                    data = get(url, binary=True)
                except Exception as e:
                    log(f"{url}: {e!r}")
                    continue
                img_hit = parse_announcement(ocr(data))
                if img_hit and (not hit or img_hit[1]):
                    hit = img_hit
                if hit and hit[1]:
                    break
        if not hit or hit[0] < today or hit[0].year in known:
            continue
        found.setdefault(hit[0], (hit[1], link))
        if hit[1]:
            found[hit[0]] = (hit[1], link)

    for start, (prompts, link) in sorted(found.items()):
        # announced-without-prompts is remembered separately, so the prompts are
        # still picked up when they're posted later
        key = f"{start}" if prompts else f"{start}?"
        if key in seen:
            continue
        seen.add(key)
        if prompts:
            lines = [f"{start + dt.timedelta(days=i)}\t{p}" for i, p in enumerate(prompts)]
            for theme_dir in (HOME / ".config/omarchy/themes/radiojoy", THEME):
                f = theme_dir / "radiojoy-week.txt"
                if f.exists():
                    with f.open("a") as fh:
                        fh.write(f"# found {today} by radiojoy-week --discover ({link}); check the prompts\n")
                        fh.write("\n".join(lines) + "\n")
            notify(f"\uf005 Radiojoy Week {start.year} is coming!",
                   f"{start:%B %-d}–{start + dt.timedelta(days=len(prompts) - 1):%-d}. The prompts were read from the "
                   f"announcement, please check them in radiojoy-week.txt:\n" + "\n".join(prompts) + f"\n{link}")
        else:
            notify(f"\uf005 Radiojoy Week {start.year} announced",
                   f"Starts {start:%B %-d}, but I couldn't read the prompts. Add them to radiojoy-week.txt:\n{link}")
    state["discover-seen"] = sorted(seen)
    save_state(state)


if __name__ == "__main__":
    main()
