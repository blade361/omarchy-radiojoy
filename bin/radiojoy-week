#!/usr/bin/env python3
# Radiojoy Week wallpaper: during the week listed in the theme's radiojoy-week.txt,
# builds a collage of only that week's art (fetched from the artists in
# radiojoy-week-artists.txt as they post it) with the prompt list beside it, past
# days crossed out. Whenever the collage changes (a new day or new art) it becomes
# the wallpaper. When the week is over it becomes a keepsake collage of all the
# week's art that stays in the wallpaper carousel (late posts are still added for
# a few days). Run hourly by radiojoy-week.timer.
#   --discover  look for an upcoming Radiojoy Week (radiojoy-week-discover.timer):
#               reads announcement banners with OCR, adds the dates and prompts to
#               radiojoy-week.txt and sends a notification to check them. Only the
#               listed artists' posts are added like that; DeviantArt and Bluesky
#               search finds (anyone can post) become suggestions:
#               radiojoy-week --accept YYYY-MM-DD
#               During a week it also suggests Bluesky accounts posting week art
#               that aren't listed yet: radiojoy-week --add-artist HANDLE
#   --update    check for new art now and say what changed (the bar button)
#   --add FILE "ARTIST" DAY
#               add a piece by hand (an artist shared it before posting it). When
#               the artist posts it, the fetched copy replaces it: no duplicate.
import datetime as dt, hashlib, html, json, os, re, subprocess, sys, urllib.parse, urllib.request
from pathlib import Path

HOME = Path.home()
THEME = HOME / ".local/state/omarchy/current/theme"
OUT_DIR = HOME / ".config/omarchy/backgrounds/radiojoy"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "radiojoy-week"
BG_LINK = HOME / ".local/state/omarchy/current/background"
UA = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) omarchy-radiojoy"}
FONTS = Path("/usr/share/fonts/noto")


def pil():
    """PIL with a pixel budget: oversized ("decompression bomb") images fail to open."""
    import warnings
    from PIL import Image
    Image.MAX_IMAGE_PIXELS = 40_000_000
    warnings.simplefilter("error", Image.DecompressionBombWarning)
    return Image


def log(*a):
    print(*a, file=sys.stderr)


def week_days(today):
    """[(date, prompt)] for the week containing today, or []."""
    for w in all_weeks():
        if w[0][0] <= today <= w[-1][0]:
            return w
    return []


def all_weeks():
    """Every week in radiojoy-week.txt, oldest first, as [(date, prompt)] lists."""
    f = THEME / "radiojoy-week.txt"
    rows = []
    for line in f.read_text().splitlines() if f.exists() else []:
        m = re.match(r"(\d{4}-\d{2}-\d{2})\t(.+)", line)
        if m:
            rows.append((dt.date.fromisoformat(m[1]), m[2].strip()))
    rows.sort()
    # consecutive runs of dates are one week
    weeks, cur = [], []
    for d, p in rows:
        if cur and (d - cur[-1][0]).days != 1:
            weeks.append(cur)
            cur = []
        cur.append((d, p))
    if cur:
        weeks.append(cur)
    return weeks


# Feeds and images come from posts, which could otherwise point at file:// paths
# or machines on the local network: only https to these hosts, checked for every
# redirect before it is followed.
FEED_HOSTS = ("api.bsky.app",  # also public.api.bsky.app
              "tumblr.com", "backend.deviantart.com")
IMAGE_HOSTS = ("cdn.bsky.app", "media.tumblr.com", "wixmp.com")  # Bluesky, Tumblr, DeviantArt CDNs
MAX_BYTES = 25 * 1024 * 1024


def allowed(url, hosts):
    u = urllib.parse.urlsplit(url)
    host = (u.hostname or "").lower()
    return u.scheme == "https" and any(host == h or host.endswith("." + h) for h in hosts)


def get(url, binary=False):
    hosts = IMAGE_HOSTS if binary else FEED_HOSTS
    if not allowed(url, hosts):
        raise ValueError(f"refusing {url!r}")

    class Redirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not allowed(newurl, hosts):
                raise ValueError(f"refusing redirect to {newurl!r}")
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    opener = urllib.request.build_opener(Redirects)
    with opener.open(urllib.request.Request(url, headers=UA), timeout=20) as r:
        data = r.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError(f"too large: {url!r}")
    return data if binary else data.decode("utf-8", "replace")


def event_date(utc):
    """A post's date in US time (UTC-6), where these events are run; a post made the
    evening of Day 1 there is already Day 2 in Europe."""
    return (utc - dt.timedelta(hours=6)).date()


def day_of(text, posted, week):
    m = re.search(r"\bday\s*([1-9])\b", text, re.I)
    if m and int(m[1]) <= len(week):
        return int(m[1])
    for i, (d, _) in enumerate(week, 1):
        if d == posted:
            return i
    return None


def fetch_bluesky(handle, week):
    feed = json.loads(get("https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed"
                          f"?actor={handle}&limit=60&filter=posts_with_media"))
    for item in feed.get("feed", []):
        if item.get("reason"):  # a repost
            continue
        p = item["post"]
        if p["author"]["handle"] != handle:
            continue
        text = p["record"].get("text", "")
        if "radiojoyweek" not in re.sub(r"[\s#_]", "", text.lower()):
            continue
        posted = event_date(dt.datetime.fromisoformat(p["record"]["createdAt"].replace("Z", "+00:00")))
        if posted < week[0][0] - dt.timedelta(days=1):
            continue
        emb = p.get("embed", {})
        images = emb.get("images") or (emb.get("media") or {}).get("images") or []
        for k, im in enumerate(images):
            yield {"id": f"{p['uri'].rsplit('/', 1)[-1]}-{k}", "url": im["fullsize"],
                   "day": day_of(text, posted, week),
                   "link": f"https://bsky.app/profile/{handle}/post/{p['uri'].rsplit('/', 1)[-1]}"}


def is_reblog(p, body, blog):
    """A Tumblr post that isn't the blog's own: the API's reblog fields, or the
    reblog markup in the body."""
    for k in ("reblogged-from-name", "reblogged-root-name"):
        if p.get(k) and p[k] != blog:
            return True
    return "tumblr_blog" in body


def fetch_tumblr(blog, week):
    raw = get(f"https://{blog}.tumblr.com/api/read/json?num=40")
    data = json.loads(raw[raw.index("{"):raw.rindex("}") + 1])
    for p in data.get("posts", []):
        body = p.get("regular-body", "") + p.get("photo-caption", "")
        if is_reblog(p, body, blog):
            continue
        tags = " ".join(t.lower() for t in p.get("tags", []))
        if "radiojoy week" not in tags and "radiojoyweek" not in tags:
            continue
        posted = event_date(dt.datetime.fromtimestamp(int(p["unix-timestamp"]), dt.timezone.utc))
        if posted < week[0][0] - dt.timedelta(days=1):
            continue
        text = html.unescape(re.sub(r"<[^>]+>", " ", body))
        urls = []
        for tag in re.findall(r"<img[^>]+>", body):
            srcset = re.search(r'srcset="([^"]+)"', tag)
            if srcset:
                best = max((c.strip().rsplit(" ", 1) for c in html.unescape(srcset[1]).split(",")),
                           key=lambda c: int(c[1].rstrip("w")))[0]
            else:
                best = re.search(r'src="([^"]+)"', tag)[1]
            urls.append(best)
        for ph in p.get("photos", []):
            urls.append(ph["photo-url-1280"])
        for k, u in enumerate(urls):
            yield {"id": f"{p['id']}-{k}", "url": u, "day": day_of(text, posted, week),
                   "link": p.get("url-with-slug") or p.get("url")}


def image_hash(data):
    """A 64-bit difference hash: survives the resizing and recompression a site
    does on upload, so a hand-added piece is recognised when it's posted."""
    import io
    Image = pil()
    try:
        im = Image.open(io.BytesIO(data)).convert("L").resize((9, 8), Image.LANCZOS)
    except Exception:
        return None
    px = list(im.tobytes())
    return sum(1 << (r * 8 + c) for r in range(8) for c in range(8) if px[r * 9 + c] > px[r * 9 + c + 1])


def same_image(a, b):
    return a is not None and b is not None and bin(a ^ b).count("1") <= 10


def add_piece(file, artist, day):
    today = dt.date.today()
    week = week_days(today) or next((w for w in reversed(all_weeks())
                                     if w[-1][0] < today <= w[-1][0] + dt.timedelta(days=GRACE_DAYS)), None)
    if not week:
        sys.exit("it isn't Radiojoy Week (or just after it)")
    if not day.isdigit() or not 1 <= int(day) <= len(week):
        sys.exit(f"DAY must be 1-{len(week)}")
    data = Path(file).read_bytes()
    h = image_hash(data)
    if h is None:
        sys.exit(f"not an image: {file}")
    year_dir = CACHE / str(week[0][0].year)
    year_dir.mkdir(parents=True, exist_ok=True)
    index_file = year_dir / "index.json"
    index = json.loads(index_file.read_text()) if index_file.exists() else {}
    for k, v in index.items():
        if v["artist"] == artist and same_image(h, v.get("hash") or image_hash((year_dir / v["file"]).read_bytes())):
            sys.exit(f"already in the collage ({k})")
    key = "manual-" + hashlib.sha1(data).hexdigest()[:12]
    (year_dir / (key + ".img")).write_bytes(data)
    index[key] = {"file": key + ".img", "artist": artist, "day": int(day), "link": "", "hash": h}
    index_file.write_text(json.dumps(index, indent=1))
    print(f"Added day {day} by {artist}. If they post it, the posted copy replaces this one.")
    sys.argv = sys.argv[:1] + ["--locked"]
    main()


def collect(week):
    """Download new week art into the cache; return the list of pieces."""
    year_dir = CACHE / str(week[0][0].year)
    year_dir.mkdir(parents=True, exist_ok=True)
    index_file = year_dir / "index.json"
    index = json.loads(index_file.read_text()) if index_file.exists() else {}
    artists = THEME / "radiojoy-week-artists.txt"
    for line in artists.read_text().splitlines() if artists.exists() else []:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        kind, account, name = (line.split(None, 2) + [""])[:3]
        try:
            found = list((fetch_bluesky if kind == "bluesky" else fetch_tumblr)(account, week))
        except Exception as e:  # offline or the site changed: keep what we have
            log(f"{account}: {e!r}")
            continue
        for art in found:
            key = f"{kind}-{account}-{art['id']}"
            if key in index or art["day"] is None:
                continue
            try:
                data = get(art["url"], binary=True)
            except Exception as e:
                log(f"{key}: {e!r}")
                continue
            if not data.startswith((b"\xff\xd8", b"\x89PNG", b"GIF8", b"RIFF")):  # jpeg/png/gif/webp
                log(f"{key}: not an image")
                continue
            artist, h = name or account, image_hash(data)
            for k in [k for k, v in index.items()  # added by hand before it was posted
                      if k.startswith("manual-") and v["artist"] == artist and same_image(h, v.get("hash"))]:
                (year_dir / index.pop(k)["file"]).unlink(missing_ok=True)
                log(f"{key} replaces {k}")
            path = year_dir / (hashlib.sha1(key.encode()).hexdigest()[:12] + ".img")
            path.write_bytes(data)
            index[key] = {"file": path.name, "artist": artist, "day": art["day"], "link": art["link"], "hash": h}
    index_file.write_text(json.dumps(index, indent=1))
    pieces = [dict(v, key=k, path=str(year_dir / v["file"])) for k, v in index.items()]
    return drop_shared(pieces)


def drop_shared(pieces):
    """An image an artist attaches to several posts (an event banner) isn't art."""
    Image = pil()
    def ahash(p):
        try:
            im = Image.open(p["path"]).convert("L").resize((8, 8))
        except Exception:
            return None
        px = list(im.tobytes())
        avg = sum(px) / len(px)
        return (p["artist"], tuple(v > avg for v in px))
    hashes = {}
    for p in pieces:
        p["hash"] = ahash(p)
        hashes.setdefault(p["hash"], set()).add(p["key"].rsplit("-", 1)[0])
    return [p for p in pieces if p["hash"] is not None and len(hashes[p["hash"]]) == 1]


def build(week, today, pieces, out, final=False):
    from PIL import ImageDraw, ImageFilter, ImageFont
    Image = pil()
    W, H = 1920, 1080
    font = lambda name, size: ImageFont.truetype(str(FONTS / name), size)
    title_f, day_f, prompt_f = font("NotoSerifDisplay-BoldItalic.ttf", 64), font("NotoSerif-Bold.ttf", 24), font("NotoSerif-Regular.ttf", 22)
    small_f = font("NotoSerif-Italic.ttf", 17)
    icon = lambda size: ImageFont.truetype("/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf", size)
    STAR, CHECK, PLAY = "\uf005", "\uf00c", "\uf04b"  # Nerd Font icons; the serifs lack them

    # crimson → periwinkle, like the theme's pair wallpaper
    bg = Image.new("RGB", (W, H))
    stops = [(0, (26, 6, 10)), (0.45, (66, 12, 26)), (0.7, (52, 38, 86)), (1, (24, 26, 58))]
    grad = Image.new("RGB", (W, 1))
    for x in range(W):
        t = x / (W - 1)
        for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
            if t <= t1:
                f = (t - t0) / (t1 - t0)
                grad.putpixel((x, 0), tuple(int(c0[i] + (c1[i] - c0[i]) * f) for i in range(3)))
                break
    bg = grad.resize((W, H))
    bg = bg.convert("RGBA")
    d = ImageDraw.Draw(bg)

    top = 70  # below the bar
    d.text((60, top + 14), STAR, font=icon(52), fill=(242, 193, 78))
    d.text((128, top), f"Radiojoy Week {week[0][0].year}", font=title_f, fill=(242, 193, 78))

    # prompt list: done days crossed out, today highlighted
    y = top + 120
    for i, (day, prompt) in enumerate(week, 1):
        label, rest = (prompt.split(":", 1) + [""])[:2]
        if final:
            col, mark = (236, 233, 247), CHECK
        elif day < today:
            col, mark = (157, 153, 188), CHECK
        elif day == today:
            col, mark = (242, 193, 78), PLAY
            hl = Image.new("RGBA", bg.size, (0, 0, 0, 0))
            ImageDraw.Draw(hl).rounded_rectangle((44, y - 10, 540, y + 72), 12, fill=(242, 193, 78, 45))
            bg.alpha_composite(hl)
            d = ImageDraw.Draw(bg)
        else:
            col, mark = (236, 233, 247), ""
        d.text((60, y + 4), mark, font=icon(22), fill=col)
        d.text((92, y), label.strip(), font=day_f, fill=col)
        d.text((92, y + 32), rest.strip(), font=prompt_f, fill=col)
        if day < today and not final:  # done: crossed out
            for yy, text, f in ((y + 17, label.strip(), day_f), (y + 47, rest.strip(), prompt_f)):
                d.line((88, yy, 92 + d.textlength(text, font=f) + 4, yy), fill=(220, 34, 73), width=3)
        y += 108
    d.text((60, H - 70), f"{len(pieces)} piece{'s' if len(pieces) != 1 else ''}"
           + (" · thank you, artists!" if final else " so far · art by the artists, credited on each"),
           font=small_f, fill=(200, 196, 220))

    # the art, scrambled, in justified rows (one height per row, every piece keeps its shape)
    ax0, ay0, ax1, ay1 = 580, top + 110, W - 40, H - 40
    images = []
    for p in pieces:
        try:
            images.append((p, Image.open(p["path"]).convert("RGB")))
        except Exception:
            continue
    if not images:
        d.text(((ax0 + ax1) // 2, (ay0 + ay1) // 2), "The art arrives here as the artists post it",
               font=prompt_f, fill=(236, 233, 247), anchor="mm")
    else:
        images = scramble(images)
        gap, cap = 26, 34  # between pieces; room for the caption under each row
        aw, ah = ax1 - ax0, ay1 - ay0
        ratios = [im.width / im.height for _, im in images]

        total = sum(ratios)

        def rows_for(k):
            """k rows of about equal total width, each scaled to the full width,
            then all shrunk together if they're too tall; returns [(start, end, height)]."""
            cuts, i = [0], 0
            for t in range(1, k):
                goal, acc = total * t / k, sum(ratios[:i])
                while i < len(ratios) - (k - t) and abs(acc + ratios[i] - goal) < abs(acc - goal):
                    acc += ratios[i]
                    i += 1
                i = max(i, cuts[-1] + 1)
                cuts.append(i)
            cuts.append(len(ratios))
            rows = [(a, b, (aw - gap * (b - a - 1)) / sum(ratios[a:b])) for a, b in zip(cuts, cuts[1:])]
            room = ah - (cap + gap) * k + gap
            scale = min(1.0, room / sum(rh for _, _, rh in rows))
            return [(a, b, rh * scale) for a, b, rh in rows]

        def height(rows):
            return sum(rh + cap for _, _, rh in rows) + gap * (len(rows) - 1)

        # the row count that shows the art biggest
        rows = max((rows_for(k) for k in range(1, len(ratios) + 1)),
                   key=lambda rows: sum(rh * rh * sum(ratios[a:b]) for a, b, rh in rows))
        y = ay0 + (ah - height(rows)) / 2
        for i, j, rh in rows:
            row_w = sum(ratios[i:j]) * rh + gap * (j - i - 1)
            x = ax0 + (aw - row_w) / 2
            for p, im in images[i:j]:
                im = im.resize((max(1, round(im.width * rh / im.height)), max(1, round(rh))), Image.LANCZOS)
                ix, iy = round(x), round(y)
                glow = Image.new("RGBA", bg.size, (0, 0, 0, 0))
                ImageDraw.Draw(glow).rectangle((ix - 6, iy - 6, ix + im.width + 6, iy + im.height + 6), fill=(242, 193, 78, 90))
                bg.alpha_composite(glow.filter(ImageFilter.GaussianBlur(10)))
                d = ImageDraw.Draw(bg)
                d.rectangle((ix - 3, iy - 3, ix + im.width + 2, iy + im.height + 2), outline=(236, 233, 247), width=2)
                bg.paste(im, (ix, iy))
                d.text((ix + im.width / 2, iy + im.height + 18), p["artist"],
                       font=small_f, fill=(236, 233, 247), anchor="mm")
                x += im.width + gap
            y += rh + cap + gap
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(".tmp.png")
    bg.convert("RGB").save(tmp)
    tmp.replace(out)


def scramble(images):
    """A mixed-up order that stays put between rebuilds (each piece's place comes
    from a hash of its key, so new art drops in somewhere without reshuffling the
    rest) and keeps an artist's pieces apart where it can."""
    images = sorted(images, key=lambda pi: hashlib.sha1(pi[0]["key"].encode()).hexdigest())
    out = []
    while images:
        last = out[-1][0]["artist"] if out else None
        left = {}
        for p, _ in images:
            left[p["artist"]] = left.get(p["artist"], 0) + 1
        # the artist with the most pieces still to place goes next, so none pile up at the end
        pick = max((a for a in left if a != last), key=lambda a: left[a], default=last)
        out.append(images.pop(next(k for k, (p, _) in enumerate(images) if p["artist"] == pick)))
    return out


def set_wallpaper(path):
    subprocess.run(["omarchy-theme-bg-set", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


GRACE_DAYS = 3  # late posts still join the keepsake collage this long after the week


def notify(title, body):
    subprocess.run(["notify-send", "-a", "Radiojoy", title, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_state():
    f = CACHE / "state.json"
    return json.loads(f.read_text()) if f.exists() else {}


def save_state(state):
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "state.json").write_text(json.dumps(state, indent=1))


def main():
    if not (THEME / "radiojoy").exists():
        return
    if "--discover" in sys.argv:
        return discover()
    if "--add" in sys.argv:
        i = sys.argv.index("--add")
        if len(sys.argv) < i + 4:
            sys.exit('usage: radiojoy-week --add FILE "ARTIST" DAY')
        return add_piece(sys.argv[i + 1], sys.argv[i + 2], sys.argv[i + 3])
    if "--accept" in sys.argv:
        return accept(sys.argv[sys.argv.index("--accept") + 1])
    if "--add-artist" in sys.argv:
        return add_artist(sys.argv[sys.argv.index("--add-artist") + 1])
    if "--update" in sys.argv:
        return update()
    if "--locked" not in sys.argv:  # the hourly timer: skip while the button is updating
        import fcntl
        CACHE.mkdir(parents=True, exist_ok=True)
        with open(CACHE / "update.lock", "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return None
            sys.argv.append("--locked")
            return main()
    today = dt.date.today()
    state = load_state()
    force = "--force" in sys.argv

    # finished weeks: keep a collage of all their art in the carousel
    for w in all_weeks():
        end, year = w[-1][0], str(w[0][0].year)
        if not end < today <= end + dt.timedelta(days=GRACE_DAYS) and not (force and end < today):
            continue
        out = OUT_DIR / f"radiojoy-week-{year}.png"
        pieces = collect(w)
        sig = hashlib.sha1(json.dumps(["final"] + sorted(p["key"] for p in pieces)).encode()).hexdigest()
        if state.get(f"final-{year}") != sig or not out.exists() or force:
            build(w, today, pieces, out, final=True)
            state[f"final-{year}"] = sig
            save_state(state)

    week = week_days(today)
    if not week:
        return
    out = OUT_DIR / f"radiojoy-week-{week[0][0].year}.png"
    pieces = collect(week)
    keys = sorted(p["key"] for p in pieces)
    new = [p for p in pieces if p["key"] not in set(state.get("keys", keys))]
    sig = hashlib.sha1(json.dumps([str(today)] + keys).encode()).hexdigest()
    if sig == state.get("sig") and out.exists() and not force:
        state["keys"] = keys
        save_state(state)
        return {"pieces": pieces, "new": new, "built": False}
    build(week, today, pieces, out)
    state["sig"], state["keys"] = sig, keys
    save_state(state)
    set_wallpaper(out)  # a new day or new art: show it
    return {"pieces": pieces, "new": new, "built": True}


def update():
    """The bar button during the week: fetch now, rebuild if anything changed, and
    say so. One at a time (the hourly timer may be running too)."""
    import fcntl
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(CACHE / "update.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return notify("\uf005 Radiojoy Week", "Already checking for new art…")
        sys.argv = [a for a in sys.argv if a != "--update"] + ["--locked"]
        if not week_days(dt.date.today()):
            return notify("\uf005 Radiojoy Week", "It isn't Radiojoy Week right now.")
        notify("\uf005 Radiojoy Week", "Checking for new art…")
        res = main()
        if res is None:
            return
        new, total = res["new"], len(res["pieces"])
        if new:
            who = ", ".join(sorted({p["artist"] for p in new}))
            notify("\uf005 Collage updated",
                   f"{len(new)} new piece{'s' * (len(new) > 1)} by {who} · {total} in all")
        elif res["built"]:
            notify("\uf005 Collage updated", f"New day, no new art yet · {total} pieces")
        else:
            notify("\uf005 Radiojoy Week", f"No new art yet · the collage has all {total} pieces")


# --- discovering the next Radiojoy Week ------------------------------------

MONTHS = "january february march april may june july august september october november december".split()
NUMBERS = {w: i for i, w in enumerate("one two three four five six seven".split(), 1)}


def parse_announcement(text):
    """Dates and prompts from an announcement (post text or OCR of its banner).
    Returns (first_date, [prompt, ...]) or None; prompts may be [] if unreadable."""
    t = re.sub(r"[ \t]+", " ", text)
    month = r"(" + "|".join(m[:3] for m in MONTHS) + r")[a-z]*\.?"
    m = re.search(month + r" (\d{1,2})(?:st|nd|rd|th)? ?[-–—~to ]+ ?(?:" + month
                  + r" )?(\d{1,2})(?:st|nd|rd|th)?,? ?(20\d\d)", t, re.I)
    if not m:
        return None
    try:
        start = dt.date(int(m[5]), [x[:3] for x in MONTHS].index(m[1].lower()) + 1, int(m[2]))
    except ValueError:  # "February 31" and the like
        return None
    prompts, last = {}, None
    for line in t.splitlines():
        line = line.strip()
        dm = re.match(r"^\W*(?:\S{0,4}\s)?(one|two|three|four|five|six|seven|[1-7])\s*[:;.]\s*(.+)$", line, re.I)
        if dm and dm[2].strip():
            n = int(dm[1]) if dm[1].isdigit() else NUMBERS[dm[1].lower()]
            prompts[n] = dm[2].strip()
            last = n
        elif last and line and (prompts[last].endswith("/") or line[:1].islower() or line.lower().startswith("and ")):
            prompts[last] += " " + line  # a prompt wrapped onto the next line
    days = [prompts.get(i, f"Day {i}") for i in range(1, 8)] if len(prompts) >= 4 else []
    return start, [f"Day {i}: {p.split(':', 1)[-1].strip() if p.startswith('Day') else p}" for i, p in enumerate(days, 1)]


def ocr(data):
    import shutil, tempfile
    if not shutil.which("tesseract"):
        return ""
    from PIL import ImageOps
    import io
    Image = pil()
    try:
        im = Image.open(io.BytesIO(data))
        if im.width * im.height > 16_000_000:  # announcements are small; skip giant images
            return ""
        im = im.convert("L")
    except Exception:
        return ""
    if im.width * im.height < 4_000_000:  # small text reads better enlarged
        im = im.resize((im.width * 2, im.height * 2))
    im = ImageOps.autocontrast(im)
    with tempfile.NamedTemporaryFile(suffix=".png") as f:
        im.save(f.name)
        try:
            return subprocess.run(["tesseract", f.name, "-"], capture_output=True, text=True, timeout=60).stdout
        except subprocess.TimeoutExpired:
            return ""


NSFW_LABELS = {"porn", "sexual", "nudity", "graphic-media", "gore"}


def bluesky_search(queries, since):
    """Posts from Bluesky's public search for any of the queries, newest first, back
    to `since` (a UTC datetime). Search is on api.bsky.app; public.api.bsky.app
    answers it with 403."""
    seen = set()
    for q in queries:
        cursor = None
        for _ in range(5):  # pages of 100
            params = {"q": q, "limit": 100, "sort": "latest", **({"cursor": cursor} if cursor else {})}
            try:
                res = json.loads(get("https://api.bsky.app/xrpc/app.bsky.feed.searchPosts?"
                                     + urllib.parse.urlencode(params)))
            except Exception as e:
                log(f"bluesky search {q!r}: {e!r}")
                break
            old = False
            for p in res.get("posts", []):
                created = p["record"].get("createdAt", "")
                try:
                    when = dt.datetime.fromisoformat(created.replace("Z", "+00:00"))
                except ValueError:
                    continue
                if when < since:
                    old = True
                    continue
                if p["uri"] not in seen:
                    seen.add(p["uri"])
                    yield p, when
            cursor = res.get("cursor")
            if old or not cursor:
                break


def week_queries(year):
    return ["radiojoy week", "radiojoyweek", f"radiojoyweek{year}", f"radiojoyweek{year + 1}"]


def post_images(p):
    emb = p.get("embed", {})
    return emb.get("images") or (emb.get("media") or {}).get("images") or []


def is_nsfw(p):
    labels = p.get("labels", []) + p["author"].get("labels", [])
    return any(l.get("val") in NSFW_LABELS for l in labels)


def announcements():
    """(text, [image urls], link, trusted) for recent posts that mention a Radiojoy Week.
    trusted: from an artist in radiojoy-week-artists.txt."""
    artists = THEME / "radiojoy-week-artists.txt"
    for line in artists.read_text().splitlines() if artists.exists() else []:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        kind, account = line.split()[:2]
        try:
            if kind == "bluesky":
                feed = json.loads(get("https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed"
                                      f"?actor={account}&limit=60"))
                for item in feed.get("feed", []):
                    p = item["post"]
                    if item.get("reason") or p["author"]["handle"] != account:  # reposts, others
                        continue
                    emb = p.get("embed", {})
                    imgs = emb.get("images") or (emb.get("media") or {}).get("images") or []
                    yield (p["record"].get("text", ""), [i["fullsize"] for i in imgs],
                           f"https://bsky.app/profile/{account}/post/{p['uri'].rsplit('/', 1)[-1]}", True)
            else:
                raw = get(f"https://{account}.tumblr.com/api/read/json?num=50")
                for p in json.loads(raw[raw.index("{"):raw.rindex("}") + 1]).get("posts", []):
                    body = p.get("regular-body", "") + p.get("photo-caption", "")
                    if is_reblog(p, body, account):
                        continue
                    text = html.unescape(re.sub(r"<[^>]+>", " ", body)) + " " + " ".join(p.get("tags", []))
                    imgs = [re.search(r'src="([^"]+)"', t)[1] for t in re.findall(r"<img[^>]+>", body)]
                    imgs += [ph["photo-url-1280"] for ph in p.get("photos", [])]
                    yield text, imgs, p.get("url-with-slug") or p.get("url"), True
        except Exception as e:
            log(f"{account}: {e!r}")
    try:  # DeviantArt's public search feed reaches beyond the listed artists
        rss = get("https://backend.deviantart.com/rss.xml?type=deviation&q=radiojoy+week")
        for item in re.findall(r"<item>(.*?)</item>", rss, re.S):
            title = html.unescape(re.search(r"<title>(.*?)</title>", item, re.S)[1])
            desc = html.unescape((re.search(r"<description>(.*?)</description>", item, re.S) or [None, ""])[1])
            img = re.search(r'<media:content url="([^"]+)"', item)
            link = re.search(r"<link>(.*?)</link>", item)[1]
            # anyone can post there: these only become suggestions you confirm
            yield title + "\n" + re.sub(r"<[^>]+>", " ", desc), [html.unescape(img[1])] if img else [], link, False
    except Exception as e:
        log(f"deviantart: {e!r}")
    # Bluesky's public search, same as DeviantArt: anyone can post, so suggestions only
    since = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=60)
    for p, _ in bluesky_search(week_queries(dt.date.today().year), since):
        handle = p["author"]["handle"]
        yield (p["record"].get("text", ""), [i["fullsize"] for i in post_images(p)],
               f"https://bsky.app/profile/{handle}/post/{p['uri'].rsplit('/', 1)[-1]}", False)


def clean(text, limit=80):
    """Prompt text from a post or OCR: no markup or control characters, bounded."""
    text = re.sub(r"[<>&\x00-\x1f\x7f]", "", text)
    return re.sub(r"\s+", " ", text).strip()[:limit]


def add_week(start, prompts, note):
    lines = [f"{start + dt.timedelta(days=i)}\t{p}" for i, p in enumerate(prompts)]
    for theme_dir in (HOME / ".config/omarchy/themes/radiojoy", THEME):
        f = theme_dir / "radiojoy-week.txt"
        if f.exists():
            with f.open("a") as fh:
                fh.write(f"# {note}\n" + "\n".join(lines) + "\n")


def discover():
    today = dt.date.today()
    known = {w[0][0].year for w in all_weeks()}
    state = load_state()
    seen = set(state.get("discover-seen", []))
    suggestions = state.get("suggestions", {})
    found = {}
    for text, imgs, link, trusted in announcements():
        if not re.search(r"radio\s*joy\s*week", text, re.I):
            continue
        hit = parse_announcement(text)
        if not (hit and hit[1]):
            for url in imgs[:2]:  # the dates and prompts are usually on the banner
                try:
                    data = get(url, binary=True)
                except Exception as e:
                    log(f"{url}: {e!r}")
                    continue
                img_hit = parse_announcement(ocr(data))
                if img_hit and (not hit or img_hit[1]):
                    hit = img_hit
                if hit and hit[1]:
                    break
        if not hit or hit[0] < today or hit[0].year in known or hit[0] > today + dt.timedelta(days=400):
            continue
        prompts = [clean(p) for p in hit[1]]
        prev = found.get(hit[0])
        # prefer a trusted source, then one that has the prompts
        if prev is None or (trusted, bool(prompts)) > (prev[2], bool(prev[0])):
            found[hit[0]] = (prompts, link, trusted)

    for start, (prompts, link, trusted) in sorted(found.items()):
        # remembered per trust level, and announced-without-prompts separately, so a
        # DeviantArt suggestion never hides a listed artist's post and prompts
        # posted later are still picked up
        key = f"{start}" + ("" if trusted else "~") + ("" if prompts else "?")
        if key in seen:
            continue
        seen.add(key)
        end = start + dt.timedelta(days=max(len(prompts), 7) - 1)
        if trusted and prompts:
            suggestions.pop(str(start), None)  # confirmed by a listed artist
            add_week(start, prompts, f"found {today} by radiojoy-week --discover ({link}); check the prompts")
            notify(f"\uf005 Radiojoy Week {start.year} is coming!",
                   f"{start:%B %-d}–{end:%-d}. The prompts were read from the announcement, please check "
                   "them in radiojoy-week.txt:\n" + "\n".join(prompts) + f"\n{link}")
        elif prompts:
            suggestions[str(start)] = {"prompts": prompts, "link": link}
            site = "Bluesky" if "bsky.app" in link else "DeviantArt"
            notify(f"\uf005 Radiojoy Week {start.year}? (unconfirmed)",
                   f"A {site} post says {start:%B %-d}–{end:%-d}. If it's real, run:\n"
                   f"radiojoy-week --accept {start}\n{link}")
        else:
            notify(f"\uf005 Radiojoy Week {start.year} announced",
                   f"Starts {start:%B %-d}, but I couldn't read the prompts yet. I'll keep looking:\n{link}")
    state["discover-seen"] = sorted(seen)
    state["suggestions"] = suggestions
    suggest_artists(today, state)
    save_state(state)


def listed_accounts():
    """Listed accounts, plus each one's bare name (termsandfeathers.bsky.social is
    the termsandfeathers already listed from Tumblr)."""
    f = THEME / "radiojoy-week-artists.txt"
    names = {l.split()[1].lower() for l in (f.read_text().splitlines() if f.exists() else [])
             if len(l.split()) >= 2 and not l.lstrip().startswith("#")}
    return names | {n.split(".")[0] for n in names}


FIC = re.compile(r"\b(fics?|fanfic|ao3|archiveofourown|one-?shot|chapter|words?)\b", re.I)


def suggest_artists(today, state):
    """During a week (and its grace days): Bluesky accounts posting week art that
    aren't in radiojoy-week-artists.txt. Only suggested, since they still need
    checking (hand-drawn, not a fic cover): radiojoy-week --add-artist HANDLE."""
    week = next((w for w in all_weeks()
                 if w[0][0] - dt.timedelta(days=1) <= today <= w[-1][0] + dt.timedelta(days=GRACE_DAYS)), None)
    if not week:
        return
    listed = listed_accounts()
    asked = set(state.get("artists-seen", []))
    pending = state.get("artist-suggestions", {})
    since = dt.datetime.combine(week[0][0] - dt.timedelta(days=1), dt.time(), dt.timezone.utc)
    posts = [p for p, _ in bluesky_search(week_queries(week[0][0].year), since)
             if "radiojoyweek" in re.sub(r"[\s#_]", "", p["record"].get("text", "").lower())]
    # writers post a picture of the fic's summary: skip anyone who posted a fic this week
    writers = {p["author"]["handle"].lower() for p in posts
               if FIC.search(p["record"].get("text", ""))
               or re.search(r"\b(writer|author)\b", p["author"].get("displayName", ""), re.I)}
    new = {}
    for p in posts:
        handle = p["author"]["handle"].lower()
        if (handle in listed or handle.split(".")[0] in listed or handle in asked or handle in new
                or handle in writers or is_nsfw(p) or not post_images(p)):
            continue
        new[handle] = {"name": clean(p["author"].get("displayName") or handle, 40) or handle,
                       "link": f"https://bsky.app/profile/{handle}/post/{p['uri'].rsplit('/', 1)[-1]}"}
    if not new:
        return
    pending.update(new)
    state["artist-suggestions"] = pending
    state["artists-seen"] = sorted(asked | set(new))
    notify(f"\uf005 {len(new)} more Radiojoy Week artist{'s' * (len(new) > 1)}?",
           "Posting week art on Bluesky. Check they draw by hand, then add with "
           "radiojoy-week --add-artist HANDLE:\n"
           + "\n".join(f"{h} ({v['name']}) {v['link']}" for h, v in sorted(new.items())))
    log("artist suggestions: " + ", ".join(sorted(new)))


def add_artist(handle):
    handle = handle.lstrip("@").lower()
    if not re.fullmatch(r"[a-z0-9.-]+", handle):
        sys.exit(f"not a Bluesky handle: {handle!r}")
    if handle in listed_accounts():
        sys.exit(f"{handle} is already listed")
    state = load_state()
    name = state.get("artist-suggestions", {}).pop(handle, {}).get("name") or handle.split(".")[0]
    for theme_dir in (HOME / ".config/omarchy/themes/radiojoy", THEME):
        f = theme_dir / "radiojoy-week-artists.txt"
        if f.exists():
            text = f.read_text()
            f.write_text(text + ("" if text.endswith("\n") or not text else "\n") + f"bluesky {handle} {name}\n")
    save_state(state)
    print(f"Added {handle} ({name}). Their week art joins the collage on the next hourly run "
          "(or now: radiojoy-week).")


def accept(start):
    state = load_state()
    sug = state.get("suggestions", {}).pop(start, None)
    if not sug:
        sys.exit(f"no suggested Radiojoy Week starting {start}")
    add_week(dt.date.fromisoformat(start), sug["prompts"], f"accepted {dt.date.today()} ({sug['link']})")
    save_state(state)
    print(f"Added Radiojoy Week starting {start}. Check the prompts in radiojoy-week.txt.")


if __name__ == "__main__":
    main()
